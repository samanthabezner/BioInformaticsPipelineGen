#Let's start by installing and uploading relevant packages.
install.packages("readxl")
install.packages("tidyverse")
install.packages("Matrix")
install.packages("lme4")
install.packages("lmerTest")
install.packages("multcomp")
install.packages("multcompView")
install.packages("emmeans")
install.packages("car")
install.packages("ggplot2")
library(ggplot2) #Allows for some really nice figures!
library(readxl) #Open .xlsx files
library(tidyverse) #Formatting tables
library(Matrix)
library(lme4) #Creating generalized linear mixed models GLMM
library(lmerTest)
library(multcomp) #Letters denoting significance
library(multcompView)
library(emmeans) #Estimated marginal means 
library(car)

#Reading of our data 
serum <- read_excel("Masterfile.xlsx", sheet="Serum", col_names = TRUE)
#Setting our required variables as factors. 
serum$Diet <- as.factor(serum$Diet)
serum$Se <- as.factor(serum$Se)
serum$Ye <- as.factor(serum$Ye)
serum$Room <- as.factor(serum$Room)

###### ALBUMIN ######

#Box plots of fixed effect (diet) and random effect (room)
ggplot(serum,aes(x=Diet, y=ALBUMIN, group = Diet))+geom_boxplot()
ggplot(serum,aes(x=Diet, y=ALBUMIN, group = Room))+geom_boxplot()


#Build model 
model.albumin <- lmer(ALBUMIN ~ Se*Ye + (1|Room), data = serum)
summary(model.albumin)
anova(model.albumin) #Diet had no significant effect on serum albumin
ranova(model.albumin) #Room and the interaction effect between room x diet didn't.

#Check Assumptions
sresid.factor.model.albumin <- residuals(model.albumin, type="pearson")
pred.factor.model.albumin <- predict(model.albumin)

par(mfrow=c(2,2))

#  To check for randomness and whether the residuals are linked to treatments
plot(pred.factor.model.albumin, sresid.factor.model.albumin, ylab="Residuals", xlab="Predicted values", main="Predicted vs Residuals")
abline(0, 0) 

#  Homogeneity of residuals for Diet
boxplot(sresid.factor.model.albumin~Diet,data=serum, main="Homogeneity of Residual 
        Variance by Diet", xlab="Diet",
        ylab="Residuals")
leveneTest(ALBUMIN ~ Diet, data = serum) #p value = 0.8183

#  Normality Assumptions!!!
qqnorm(sresid.factor.model.albumin)
qqline(sresid.factor.model.albumin, col="steelblue")
#  Shapiro-Wilk Test W = 0.9426, p-value = 0.1864
shapiro.test(sresid.factor.model.albumin)

#Estimated marginal means + significance of parameter.
albumin.emmean <- emmeans(model.albumin, pairwise ~ Se*Ye, type = "response", adjust = "tukey")
albumin.emmean
albumin.cld <- cld(object = albumin.emmean, adjust = "Tukey", Letters = letters, alpha = 0.05)
albumin.cld


